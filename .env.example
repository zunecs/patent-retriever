# EPO OPS credentials
#
# 1. Register a free account at https://developers.epo.org/
# 2. Create an app under "My Apps". OPS issues it a Consumer Key and a
#    Consumer Secret.
# 3. Paste them below. Both are required; setting only one is a configuration
#    error, and the tool names the variable that is missing.
#
# One retrieval costs four requests: auth, biblio, claims, description.
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Source priority, comma-separated, tried left to right until one succeeds.
# Put epo_ops first for EP and WO patents - it is an official API rather than a
# scrape. It cannot serve US full text, so keep google_patents behind it:
#   PATENT_SOURCE_ORDER=epo_ops,google_patents
PATENT_SOURCE_ORDER=google_patents

# Network
HTTP_TIMEOUT_SECONDS=20

# Where generated files are written
OUTPUT_DIR=./output
